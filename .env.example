# Copie para .env no servidor (chmod 600) e preencha. Nunca coloque o .env no git.
SITE_HOST=spraytec.canchamarketing.com.br
POSTGRES_PASSWORD=
COOKIE_SEGREDO=

# Modo demonstração: com DEMO_CODIGO preenchido, a tela de entrada pede este código e
# mostra as pessoas de demonstração. Deixe vazio quando o portal entrar em uso real.
DEMO_CODIGO=
# Data de referência dos dados fictícios (opcional, AAAA-MM-DD). Vazio = hoje.
DEMO_HOJE=

# Envio de e-mail (convites e "esqueci minha senha").
# Modo usado: redirecionamento SMTP do Google Workspace (sem usuário/senha; o Google aceita o IP do servidor).
# Se o servidor mudar de IP, atualize a regra em admin.google.com > Gmail > Roteamento > Serviço de redirecionamento SMTP.
# SMTP_HOST=smtp-relay.gmail.com  SMTP_PORT=587  SMTP_NOME=spraytec.canchamarketing.com.br  (SMTP_USUARIO e SMTP_SENHA vazios)
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
SMTP_NOME=

# Integração com o Meta (Instagram, Página e anúncios da Spraytec), só leitura.
# META_TOKEN: chave do usuário do sistema do portfólio da Cancha (não expira). Cole só aqui, nunca no chat.
# Se a chave enxergar mais de uma página ou conta de anúncios, diga qual usar (ids do Meta).
META_TOKEN=
META_PAGINA_ID=
META_CONTA_ANUNCIOS=
